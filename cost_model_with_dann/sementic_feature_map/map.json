{
  "buffer_pool_size": {
    "postgres": ["shared_buffers"],
    "mysql": ["innodb_buffer_pool_size"],
    "aggregation": "direct"
  },
  "cache_effective_size": {
    "postgres": ["effective_cache_size"],
    "mysql": ["innodb_buffer_pool_size"],
    "aggregation": "direct_reuse"
  },
  "per_query_memory": {
    "postgres": ["work_mem"],
