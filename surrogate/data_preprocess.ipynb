"   \"source\": [\n",
"    \"# Extract features and target\\n\",\n",
"    \"dataset = []\\n\",\n",
"    \"\\n\",\n",
"    \"workloads = data.get('workloads', {})\\n\",\n",
"    \"for workload_name, workload_data in workloads.items():\\n\",\n",
"    \"    collected_data = workload_data.get('collected_data', {})\\n\",\n",
"    \"    run_history = workload_data.get('run_history', [])\\n\",\n",
"    \"    \\n\",\n",
"    \"    # 1. Extract Workload-level features\\n\",\n",
"    \"    # These are static for all configurations within the same workload\\n\",\n",
"    \"    internal_metrics = collected_data.get('internal_metrics', {})\\n\",\n",
"    \"    workload_features = collected_data.get('workload_features', {})\\n\",\n",
"    \"    operator_proportions = workload_features.get('operator_proportions', {})\\n\",\n",
"    \"    \\n\",\n",
"    \"    base_features = {}\\n\",\n",
"    \"    \\n\",\n",
"    \"    # Add internal metrics directly\\n\",\n",
"    \"    for k, v in internal_metrics.items():\\n\",\n",
"    \"        if isinstance(v, (int, float)):\\n\",\n",
"    \"            base_features[f\\\"im_{k}\\\"] = v\\n\",\n",
"    \"            \\n\",\n",
"    \"    # Add scalar workload features\\n\",\n",
"    \"    for k, v in workload_features.items():\\n\",\n",
"    \"        if isinstance(v, (int, float)) and not isinstance(v, bool):\\n\",\n",
"    \"            base_features[f\\\"wf_{k}\\\"] = v\\n\",\n",
"    \"            \\n\",\n",
"    \"    # Add operator proportions\\n\",\n",
"    \"    for k, v in operator_proportions.items():\\n\",\n",
"    \"        base_features[f\\\"op_{k}\\\"] = v\\n\",\n",
"    \"        \\n\",\n",
"    \"    # 2. Extract Configuration-level (Knobs) features and Target (Cost)\\n\",\n",
"    \"    for record in run_history:\\n\",\n",
"    \"        config = record.get('config', {})\\n\",\n",
"    \"        cost = record.get('cost', None)\\n\",\n",
"    \"        \\n\",\n",
"    \"        if cost is None:\\n\",\n",
"    \"            continue\\n\",\n",
"    \"            \\n\",\n",
"    \"        # Combine all features for this record\\n\",\n",
"    \"        row = {'workload': workload_name, 'cost': cost}\\n\",\n",
"    \"        row.update(base_features)\\n\",\n",
"    \"        \\n\",\n",
"    \"        # Add knob configurations\\n\",\n",
"    \"        for k, v in config.items():\\n\",\n",
"    \"            row[f\\\"knob_{k}\\\"] = v\\n\",\n",
"    \"            \\n\",\n",
"    \"        dataset.append(row)\\n\",\n",
"    \"\\n\",\n",
"    \"# Create DataFrame\\n\",\n",
"    \"df = pd.DataFrame(dataset)\\n\",\n",
"    \"print(f\\\"Dataset shape: {df.shape}\\\")\\n\",\n",
"    \"df.head()\"\n",
"   ]\n",
"  },\n",
"  {\n",
