"   \"execution_count\": 9,\n",
"   \"metadata\": {},\n",
"   \"outputs\": [\n",
"    {\n",
"     \"name\": \"stdout\",\n",
"     \"output_type\": \"stream\",\n",
"     \"text\": [\n",
"      \"Features:\\n\",\n",
"      \"['im_xact_commit', 'im_xact_rollback', 'im_blks_read', 'im_blks_hit', 'im_tup_returned', 'im_tup_fetched', 'im_tup_inserted', 'im_conflicts', 'im_tup_updated', 'im_tup_deleted', 'im_disk_read_count', 'im_disk_write_count', 'im_disk_read_bytes', 'im_disk_write_bytes', 'wf_total_statements', 'wf_read_count', 'wf_write_count', 'wf_avg_predicates_per_query', 'op_order_by', 'op_group_by', 'op_count_agg', 'op_sum_agg', 'op_avg_agg', 'op_min_agg', 'op_max_agg', 'knob_max_wal_senders', 'knob_autovacuum_max_workers', 'knob_max_connections', 'knob_wal_buffers', 'knob_shared_buffers', 'knob_autovacuum_analyze_scale_factor', 'knob_autovacuum_analyze_threshold', 'knob_autovacuum_naptime', 'knob_autovacuum_vacuum_cost_delay', 'knob_autovacuum_vacuum_cost_limit', 'knob_autovacuum_vacuum_scale_factor', 'knob_autovacuum_vacuum_threshold', 'knob_backend_flush_after', 'knob_bgwriter_delay', 'knob_bgwriter_flush_after', 'knob_bgwriter_lru_maxpages', 'knob_bgwriter_lru_multiplier', 'knob_checkpoint_completion_target', 'knob_checkpoint_flush_after', 'knob_checkpoint_timeout', 'knob_commit_delay', 'knob_commit_siblings', 'knob_cursor_tuple_fraction', 'knob_deadlock_timeout', 'knob_default_statistics_target', 'knob_effective_cache_size', 'knob_effective_io_concurrency', 'knob_from_collapse_limit', 'knob_geqo_effort', 'knob_geqo_generations', 'knob_geqo_pool_size', 'knob_geqo_seed', 'knob_geqo_threshold', 'knob_join_collapse_limit', 'knob_maintenance_work_mem', 'knob_temp_buffers', 'knob_temp_file_limit', 'knob_vacuum_cost_delay', 'knob_vacuum_cost_limit', 'knob_vacuum_cost_page_dirty', 'knob_vacuum_cost_page_hit', 'knob_vacuum_cost_page_miss', 'knob_wal_writer_delay', 'knob_work_mem']\\n\"\n",
"     ]\n",
"    }\n",
"   ],\n",
"   \"source\": [\n",
"    \"# Clean and Preprocess Data\\n\",\n",
"    \"# Drop workload name as it is just an identifier, or encode it if needed.\\n\",\n",
"    \"# Here we'll drop it so the model generalizes across workloads.\\n\",\n",
"    \"if 'workload' in df.columns:\\n\",\n",
"    \"    df_features = df.drop(columns=['workload'])\\n\",\n",
"    \"else:\\n\",\n",
"    \"    df_features = df.copy()\\n\",\n",
"    \"\\n\",\n",
"    \"# Handle missing values by filling with 0 or median\\n\",\n",
"    \"df_features.fillna(0, inplace=True)\\n\",\n",
"    \"\\n\",\n",
"    \"# Separate X and y\\n\",\n",
"    \"X = df_features.drop('cost', axis=1)\\n\",\n",
"    \"y = df_features['cost']\\n\",\n",
"    \"\\n\",\n",
"    \"print(\\\"Features:\\\")\\n\",\n",
"    \"print(X.columns.tolist())\"\n",
"   ]\n",
"  },\n",
"  {\n",
"   \"cell_type\": \"code\",\n",
"   \"execution_count\": 10,\n",
"   \"metadata\": {},\n",
"   \"outputs\": [\n",
"    {\n",
"     \"name\": \"stdout\",\n",
"     \"output_type\": \"stream\",\n",
"     \"text\": [\n",
"      \"Applied Min-Max scaling to 44 knob features and 14 internal metrics.\\n\"\n",
"     ]\n",
"    }\n",
"   ],\n",
"   \"source\": [\n",
"    \"# Isolate knob features and internal metrics\\n\",\n",
"    \"knob_cols = [c for c in X.columns if c.startswith('knob_')]\\n\",\n",
"    \"im_cols = [c for c in X.columns if c.startswith('im_')]\\n\",\n",
"    \"\\n\",\n",
"    \"cols_to_minmax = knob_cols + im_cols\\n\",\n",
"    \"\\n\",\n",
"    \"# Apply Min-Max scaling to numerical knob and internal metric features to standardize their varying ranges BEFORE splitting\\n\",\n",
"    \"if cols_to_minmax:\\n\",\n",
"    \"    min_max_scaler = MinMaxScaler()\\n\",\n",
"    \"    X[cols_to_minmax] = min_max_scaler.fit_transform(X[cols_to_minmax])\\n\",\n",
"    \"    \\n\",\n",
"    \"    print(f\\\"Applied Min-Max scaling to {len(knob_cols)} knob features and {len(im_cols)} internal metrics.\\\")\\n\",\n",
"    \"else:\\n\",\n",
"    \"    print(\\\"No features found to scale.\\\")\"\n",
"   ]\n",
"  },\n",
"  {\n",
"   \"cell_type\": \"code\",\n",
"   \"execution_count\": null,\n",
"   \"metadata\": {},\n",
"   \"outputs\": [],\n",
"   \"source\": [\n",
"    \"# --- ONLY USE KNOBS AND INTERNAL METRICS FOR MODEL TRAINING ---\\n\",\n",
"    \"# We intentionally ignore 'wf_' (workload feature values) and 'op_' (operator proportions)\\n\",\n",
"    \"# so the model purely learns from database configurations and internal state tracking.\\n\",\n",
"    \"\\n\",\n",
"    \"selected_features = [c for c in X.columns if c.startswith('knob_') or c.startswith('im_')]\\n\",\n",
"    \"X_filtered = X[selected_features]\\n\",\n",
"    \"\\n\",\n",
"    \"# Train-test split\\n\",\n",
"    \"X_train, X_test, y_train, y_test = train_test_split(X_filtered, y, test_size=0.2, random_state=42)\\n\",\n",
"    \"\\n\",\n",
"    \"# Convert splits to DataFrames if they aren't already\\n\",\n",
"    \"X_train_scaled = pd.DataFrame(X_train, columns=X_filtered.columns)\\n\",\n",
"    \"X_test_scaled = pd.DataFrame(X_test, columns=X_filtered.columns)\\n\",\n",
"    \"\\n\",\n",
"    \"# Since we min-max scaled 'knob_*' and 'im_*' in the previous cell, we do not need \\n\",\n",
"    \"# to run them through StandardScaler here anymore, since they are the ONLY features left!\\n\",\n",
"    \"\\n\",\n",
"    \"print(f\\\"X_train shape: {X_train_scaled.shape}\\\")\\n\",\n",
"    \"print(f\\\"X_test shape: {X_test_scaled.shape}\\\")\"\n",
"   ]\n",
"  }\n",
" ],\n",
